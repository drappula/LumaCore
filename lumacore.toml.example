# lumacore.toml — LumaCore configuration
# Place this file in your Steam installation directory (next to steam.exe).
# Rename to lumacore.toml to activate. All sections are optional — missing
# keys fall back to the defaults shown below.

[log]
# Log level: "debug", "info", "warn", "error"
level = "debug"
# Extra verbose logging in debug builds
verbose = true

[lua]
# Extra directories to watch for .lua files (beyond config/stplug-in/)
paths = []

[manifest_fetch]
# URL chain for depot manifest downloads, tried in order until one returns 200.
# {gid} is replaced with the manifest GID at request time; {appid} and
# {depotid} identify the depot being resolved (first provider needs them).
# The first built-in provider needs a compatibility User-Agent; LumaCore adds it internally.
urls = [
    "https://manifest.opensteamtool.com/{appid}/{depotid}/{gid}",
    "https://manifest.steam.run/api/manifest/{gid}",
    "http://gmrc.wudrm.com/manifest/{gid}",
]
# Max seconds to wait per provider before trying the next one
timeout_sec = 12
# Trusted host allowlist — responses from other hosts are rejected
trusted_hosts = [
    "manifest.opensteamtool.com",
    "manifest.steam.run",
    "gmrc.wudrm.com",
]

[pattern_fetch]
# Custom mirror URL for per-build pattern TOMLs. {subdir} = steamclient or
# steamui, {sha} = lowercase hex SHA-256 of the DLL. Leave empty to use
# the default GitHub + jsDelivr + local cache chain.
mirror = ""

[stats]
# Enable stats and achievement API
enable_api = true

[donate]
# Contribute manifest request codes for depots THIS account owns, so other
# users can download those games. Codes are minted on demand from your
# signed-in Steam session and posted immediately (never stored). Only depots
# you actually own are ever reported — the rest of your library is never
# uploaded. Set enabled = false to opt out completely.
enabled = true
# Seconds to rest between mint cycles (default 30).
interval_secs = 30
# How often to re-pull the wanted list; minting still runs every cycle
# (default 300 = 5 min).
wanted_refresh_secs = 300
# Max Steam code mints per cycle (default 25).
max_mints_per_cycle = 25
# Minimum gap between consecutive Steam calls, ms — the real rate cap (default 2000).
min_mint_interval_ms = 2000
# Total mints per Steam session; 0 = unlimited (default 0).
max_mints_per_session = 0

[process_extension]
# Inject an extension DLL into game processes at launch
enabled = false
# Path to 32-bit extension DLL
x86 = ""
# Path to 64-bit extension DLL
x64 = ""

[onlinefix]
# Inject LumaCorePayload.dll into online-fix game processes for EOS bridge
inject_enabled = true

[boot]
# Show a diagnostic popup with Steam build ID and steamclient SHA256 when
# patterns can't load (new Steam build, network down, GitHub cache miss).
# The popup data is what you need to report a missing build.
diagnostic_popup = true

[steamstub]
# Automatically activate the SteamStub bypass route when launching a
# Lua-tracked game that has SteamStub protection, is not owned, and
# has no manual stub flag set. Set to false to disable automatic bypass
# (manual flag override in the Lua pattern still works).
auto_enabled = false
